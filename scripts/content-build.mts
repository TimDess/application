/**
 * Compiles content/**\/*.json into idempotent SQL (supabase/content/<course>.sql).
 *
 *   node scripts/content-build.mts            build every course
 *   node scripts/content-build.mts --publish  same, but force status "published" (local dev / CI only)
 *
 * IDs are deterministic (derived from slugs/keys), so re-running the SQL updates
 * rows in place and keeps users' progress attached to the same lessons.
 * Solutions and explanations go to private.question_solutions only.
 */
import { createHash } from 'node:crypto'
import { mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs'
import { join, relative } from 'node:path'
import {
  courseFileSchema,
  type ContentQuestion,
  type CourseFile,
} from '../src/features/content/schema.ts'

const ROOT = new URL('..', import.meta.url).pathname
const CONTENT_DIR = join(ROOT, 'content')
const OUT_DIR = join(ROOT, 'supabase', 'content')
const publish = process.argv.includes('--publish')

export function stableUuid(kind: string, key: string): string {
  const h = createHash('sha1').update(`kulto:${kind}:${key}`).digest('hex')
  const variant = ((parseInt(h[16]!, 16) & 0x3) | 0x8).toString(16)
  return `${h.slice(0, 8)}-${h.slice(8, 12)}-5${h.slice(13, 16)}-${variant}${h.slice(17, 20)}-${h.slice(20, 32)}`
}

function seededShuffle<T>(items: T[], seed: string): T[] {
  let s = parseInt(createHash('sha1').update(seed).digest('hex').slice(0, 8), 16)
  const rand = () => {
    s = (s + 0x6d2b79f5) | 0
    let t = Math.imul(s ^ (s >>> 15), 1 | s)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
  const out = [...items]
  for (let i = out.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1))
    ;[out[i], out[j]] = [out[j]!, out[i]!]
  }
  return out
}

/** Shuffles until the order differs from the original (so the payload never leaks the answer). */
function shuffleDifferent<T>(items: T[], seed: string): T[] {
  for (let attempt = 0; attempt < 20; attempt++) {
    const out = seededShuffle(items, `${seed}:${attempt}`)
    if (out.some((x, i) => x !== items[i])) return out
  }
  return [...items].reverse()
}

const q = (v: string) => `'${v.replaceAll("'", "''")}'`
const json = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`
const nullable = (v: string | undefined) => (v ? q(v) : 'null')

/** Splits a question into its public payload and its private solution. */
export function compileQuestion(question: ContentQuestion): {
  payload: unknown
  solution: unknown
} {
  switch (question.format) {
    case 'quiz': {
      const options = question.options.map((o, i) => ({
        id: String.fromCharCode(97 + i),
        label: o.label,
        correct: o.correct,
      }))
      const correct = options.filter((o) => o.correct).map((o) => o.id)
      return {
        payload: {
          options: options.map(({ id, label }) => ({ id, label })),
          multiple: correct.length > 1,
        },
        solution: { correct },
      }
    }
    case 'true_false':
      return { payload: {}, solution: { value: question.answer } }
    case 'match': {
      const left = question.pairs.map((p, i) => ({ id: `l${i + 1}`, label: p.left }))
      const right = question.pairs.map((p, i) => ({ id: `r${i + 1}`, label: p.right }))
      const pairs = Object.fromEntries(left.map((l, i) => [l.id, right[i]!.id]))
      return {
        payload: { left, right: shuffleDifferent(right, `${question.key}:right`) },
        solution: { pairs },
      }
    }
    case 'timeline': {
      const items = question.items.map((it, i) => ({
        id: `t${i + 1}`,
        label: it.label,
        date: it.date,
      }))
      return {
        payload: {
          items: shuffleDifferent(items, `${question.key}:items`).map(({ id, label }) => ({
            id,
            label,
          })),
        },
        solution: {
          order: items.map((it) => it.id),
          dates: Object.fromEntries(items.map((it) => [it.id, it.date])),
        },
      }
    }
    case 'guess_year':
      return {
        payload: { min: question.min, max: question.max },
        solution: { year: question.year, tolerance: question.tolerance },
      }
  }
}

export function compileCourse(file: CourseFile, forcePublish = false): string {
  const status = forcePublish ? 'published' : file.status
  const categoryId = stableUuid('category', `${file.universe}/${file.category.slug}`)
  const courseId = stableUuid('course', file.course.slug)
  const universe = `(select id from public.universes where slug = ${q(file.universe)})`
  const lines: string[] = []
  const push = (s: string) => lines.push(s)

  push(
    `-- Generated by scripts/content-build.mts from content/${file.universe}/${file.course.slug}.json. Do not edit by hand.`,
  )
  push('begin;')
  push(
    `do $$ begin if not exists (select 1 from public.universes where slug = ${q(file.universe)}) then raise exception 'unknown universe ${file.universe}'; end if; end $$;`,
  )

  push(`insert into public.categories (id, universe_id, slug, name, description, sort_order, status)
values (${q(categoryId)}, ${universe}, ${q(file.category.slug)}, ${q(file.category.name)}, ${q(file.category.description)}, 10, ${q(status)})
on conflict (id) do update set name = excluded.name, description = excluded.description,
  status = case when public.categories.status = 'published' then 'published'::public.content_status else excluded.status end;`)

  push(`insert into public.courses (id, category_id, slug, title, description, level, sort_order, status)
values (${q(courseId)}, ${q(categoryId)}, ${q(file.course.slug)}, ${q(file.course.title)}, ${q(file.course.description)}, ${q(file.course.level)}, 10, ${q(status)})
on conflict (id) do update set title = excluded.title, description = excluded.description, level = excluded.level, status = excluded.status;`)

  // Free positions before upserting, so reordering never hits the unique (parent, position) constraints.
  push(`update public.chapters set position = position + 1000 where course_id = ${q(courseId)};`)
  push(
    `update public.lessons set position = position + 1000 where chapter_id in (select id from public.chapters where course_id = ${q(courseId)});`,
  )

  for (const k of file.knowledge) {
    push(`insert into public.knowledge_items (id, key, universe_id, title, summary, is_evolving, valid_as_of, verified_at, source_url)
values (${q(stableUuid('knowledge', k.key))}, ${q(k.key)}, ${universe}, ${q(k.title)}, ${q(k.summary)}, ${k.isEvolving}, ${nullable(k.validAsOf)}, ${nullable(k.verifiedAt)}, ${nullable(k.sourceUrl)})
on conflict (id) do update set title = excluded.title, summary = excluded.summary, is_evolving = excluded.is_evolving,
  valid_as_of = excluded.valid_as_of, verified_at = excluded.verified_at, source_url = excluded.source_url;`)
  }

  const questionIds = file.questions.map((qq) => stableUuid('question', qq.key))
  for (const question of file.questions) {
    const id = stableUuid('question', question.key)
    const { payload, solution } = compileQuestion(question)
    push(`insert into public.questions (id, key, universe_id, format, prompt, payload, difficulty, is_evolving, valid_as_of, status)
values (${q(id)}, ${q(question.key)}, ${universe}, ${q(question.format)}, ${q(question.prompt)}, ${json(payload)}, ${question.difficulty}, ${question.isEvolving}, ${nullable(question.validAsOf)}, ${q(status)})
on conflict (id) do update set format = excluded.format, prompt = excluded.prompt, payload = excluded.payload,
  difficulty = excluded.difficulty, is_evolving = excluded.is_evolving, valid_as_of = excluded.valid_as_of, status = excluded.status;`)
    push(`insert into private.question_solutions (question_id, solution, explanation)
values (${q(id)}, ${json(solution)}, ${q(question.explanation)})
on conflict (question_id) do update set solution = excluded.solution, explanation = excluded.explanation, updated_at = now();`)
  }

  const idList = questionIds.map(q).join(', ')
  push(`delete from public.question_knowledge_items where question_id in (${idList});`)
  for (const question of file.questions) {
    for (const k of question.knowledge) {
      push(
        `insert into public.question_knowledge_items (question_id, knowledge_item_id) values (${q(stableUuid('question', question.key))}, ${q(stableUuid('knowledge', k))});`,
      )
    }
  }

  const chapterIds: string[] = []
  const lessonIds: string[] = []
  file.chapters.forEach((chapter, ci) => {
    const chapterId = stableUuid('chapter', `${file.course.slug}/${ci + 1}`)
    chapterIds.push(chapterId)
    push(`insert into public.chapters (id, course_id, position, title, description, status)
values (${q(chapterId)}, ${q(courseId)}, ${ci + 1}, ${q(chapter.title)}, ${q(chapter.description)}, ${q(status)})
on conflict (id) do update set position = excluded.position, title = excluded.title, description = excluded.description, status = excluded.status;`)

    chapter.lessons.forEach((lesson, li) => {
      const lessonId = stableUuid('lesson', lesson.slug)
      lessonIds.push(lessonId)
      push(`insert into public.lessons (id, chapter_id, position, slug, title, objective, kind, estimated_minutes, status)
values (${q(lessonId)}, ${q(chapterId)}, ${li + 1}, ${q(lesson.slug)}, ${q(lesson.title)}, ${q(lesson.objective)}, ${q(lesson.kind)}, ${lesson.minutes}, ${q(status)})
on conflict (id) do update set chapter_id = excluded.chapter_id, position = excluded.position, title = excluded.title,
  objective = excluded.objective, kind = excluded.kind, estimated_minutes = excluded.estimated_minutes, status = excluded.status;`)
      push(`delete from public.learning_cards where lesson_id = ${q(lessonId)};`)
      push(`delete from public.lesson_items where lesson_id = ${q(lessonId)};`)
      lesson.cards.forEach((card, pi) => {
        push(
          `insert into public.learning_cards (lesson_id, position, title, blocks) values (${q(lessonId)}, ${pi + 1}, ${q(card.title)}, ${json(card.blocks)});`,
        )
      })
      lesson.questions.forEach((key, pi) => {
        push(
          `insert into public.lesson_items (lesson_id, position, question_id) values (${q(lessonId)}, ${pi + 1}, ${q(stableUuid('question', key))});`,
        )
      })
    })
  })

  // Anything that disappeared from the file is archived (never deleted: progress may point to it).
  push(
    `update public.lessons set status = 'archived', position = position + 2000 where position > 1000 and chapter_id in (select id from public.chapters where course_id = ${q(courseId)}) and id not in (${lessonIds.map(q).join(', ')});`,
  )
  push(
    `update public.chapters set status = 'archived', position = position + 2000 where position > 1000 and course_id = ${q(courseId)} and id not in (${chapterIds.map(q).join(', ')});`,
  )
  push('commit;')
  return `${lines.join('\n')}\n`
}

function listJson(dir: string): string[] {
  return readdirSync(dir).flatMap((name) => {
    const path = join(dir, name)
    if (statSync(path).isDirectory()) return listJson(path)
    return name.endsWith('.json') ? [path] : []
  })
}

function main() {
  mkdirSync(OUT_DIR, { recursive: true })
  let failed = false
  for (const path of listJson(CONTENT_DIR)) {
    const parsed = courseFileSchema.safeParse(JSON.parse(readFileSync(path, 'utf8')))
    if (!parsed.success) {
      failed = true
      console.error(`✗ ${relative(ROOT, path)}`)
      for (const issue of parsed.error.issues)
        console.error(`  - ${issue.path.join('.')}: ${issue.message}`)
      continue
    }
    const out = join(OUT_DIR, `${parsed.data.course.slug}${publish ? '.published' : ''}.sql`)
    writeFileSync(out, compileCourse(parsed.data, publish))
    const lessons = parsed.data.chapters.reduce((n, c) => n + c.lessons.length, 0)
    console.log(
      `✓ ${relative(ROOT, path)} → ${relative(ROOT, out)} (${lessons} leçons, ${parsed.data.questions.length} questions, statut ${publish ? 'published' : parsed.data.status})`,
    )
  }
  if (failed) process.exit(1)
}

if (process.argv[1] && import.meta.url.endsWith(process.argv[1].split('/').pop()!)) main()

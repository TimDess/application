# Copy to .env.local and fill in. Never commit real values.
# Values for local development are printed by `pnpm db:start` (supabase start).

# Public: safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server only: never prefix with NEXT_PUBLIC_, never log, never commit.
# Used only for account deletion (auth admin API). Imported exclusively from server-only modules.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
